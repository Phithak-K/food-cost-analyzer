{
  "name": "food-costing-backend",
  "version": "1.0.0",
  "description": "PostgreSQL & Prisma Database Layer for Food Costing & Menu Engineering",
  "scripts": {
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev --name init",
    "prisma:seed": "prisma db seed",
    "dev": "ts-node src/index.ts",
    "server:start": "ts-node src/index.ts",
    "server:dev": "ts-node src/index.ts",
    "build": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "ts-node src/tests/unitConverter.test.ts && ts-node src/tests/ordersValidation.test.ts"
  },
  "prisma": {
    "seed": "ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "cors": "^2.8.6",
    "express": "^5.3.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.0",
    "prisma": "^5.22.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.0"
  }
}
